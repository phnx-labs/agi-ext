{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/vscode/extension.ts",
        "src/mcp/watchdog-server.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ],
      "ignore": [
        "src/testing/**",
        "**/testdata/**"
      ],
      "ignoreBinaries": [
        "tsc",
        "vsce",
        "agents"
      ]
    },
    "ui": {
      "entry": [
        "settings/main.tsx",
        "editor/main.tsx",
        "vite.config.ts",
        "vite.settings.config.ts",
        "vite.editor.config.ts",
        "vite.standalone.config.ts",
        "test-setup.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    },
    "app": {
      "entry": [
        "main.ts",
        "preload.ts"
      ],
      "project": [
        "**/*.ts"
      ],
      "ignoreBinaries": [
        "electron",
        "electron-builder"
      ],
      "ignoreDependencies": [
        "electron-builder"
      ]
    }
  }
}
