{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/vscode/extension.ts",
        "src/mcp/watchdog-bridge.ts",
        "src/mcp/watchdog-server.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ],
      "ignore": [
        "src/testing/**",
        "**/testdata/**"
      ],
      "ignoreBinaries": [
        "tsc",
        "vsce",
        "agents"
      ]
    },
    "ui": {
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "autoprefixer",
        "postcss",
        "tailwindcss"
      ]
    }
  }
}
