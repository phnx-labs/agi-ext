{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ],
      "ignore": [
        "**/testdata/**"
      ],
      "ignoreBinaries": [
        "vsce",
        "agents",
        "osascript",
        "notify-send"
      ]
    },
    "ui": {
      "project": [
        "**/*.{ts,tsx}"
      ]
    }
  }
}
