{
  "name": "swarm-ext",
  "displayName": "Agents",
  "publisher": "swarmify",
  "description": "Run Claude, Codex, Antigravity, Cursor, and other coding agents from one IDE workspace.",
  "version": "0.9.319",
  "license": "MIT",
  "author": "Muqsit Nawaz <dev@muqsitnawaz.com>",
  "icon": "assets/logo.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phnx-labs/agi-ext"
  },
  "homepage": "https://swarmify.co/#agents-ext",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agent",
    "claude",
    "codex",
    "cursor",
    "copilot",
    "swarm",
    "orchestration",
    "mcp",
    "multi-agent",
    "coding-agent",
    "ai-coding",
    "llm",
    "iae",
    "agents-cli"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onLanguage:markdown",
    "onCustomEditor:agents.markdownEditor",
    "onCustomEditor:agents.htmlReader"
  ],
  "main": "./out/vscode/extension.js",
  "contributes": {
    "iconThemes": [
      {
        "id": "agents-icons",
        "label": "Agents File Icons",
        "path": "./icons/agents-icons.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "agents.markdownEditor",
        "displayName": "Agents Reader (Markdown)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "agents.htmlReader",
        "displayName": "Agents Reader (HTML)",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ],
        "priority": "option"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.confirmOnKill": "panel",
      "terminal.integrated.enablePersistentSessions": false,
      "terminal.integrated.commandsToSkipShell": [
        "agents.lead.ask",
        "agents.lead.talk"
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentsPanel",
          "title": "Agents",
          "icon": "assets/agents-activity.svg"
        },
        {
          "id": "agentsProject",
          "title": "Project",
          "icon": "assets/project-activity.svg"
        }
      ]
    },
    "views": {
