#!/usr/bin/env node
// A bounded test double for `agents projects list --json`: a real subprocess, so the
// registry's read, its timing and its argv run against a process.
//
//   PROJECTS_STUB_LOG=<file>   append each argv (JSON, one line) for assertions
//   PROJECTS_STUB_NAME=<name>  the one project it lists (default: agi-ui)
//   PROJECTS_STUB_DELAY_MS=<n> answer after n ms, as a loaded machine does
const fs = require('fs');
const argv = process.argv.slice(2);
if (process.env.PROJECTS_STUB_LOG) fs.appendFileSync(process.env.PROJECTS_STUB_LOG, JSON.stringify(argv) + '\n');
if (argv.join(' ') !== 'projects list --json') { process.stderr.write(`error: unknown command '${argv.join(' ')}'\n`); process.exit(1); }
const name = process.env.PROJECTS_STUB_NAME || 'agi-ui';
setTimeout(() => {
  process.stdout.write(JSON.stringify([{ name, root: '~/src/agi-ext', repo: 'phnx-labs/agi-ext' }]) + '\n');
}, Number(process.env.PROJECTS_STUB_DELAY_MS || 0));
