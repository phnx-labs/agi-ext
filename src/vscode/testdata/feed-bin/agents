#!/usr/bin/env node
// A bounded test double for `agents feed answer <key> --choice|--text … --json`:
// a real subprocess, so the panel's argv, exit and error paths run against a process.
//
//   FEED_STUB_LOG=<file>    append each argv (JSON, one line) for assertions
//   FEED_STUB_MODE=failed   answer like agents-cli when no rail delivered (exit 0)
//   FEED_STUB_MODE=error    exit 1 with the CLI's JSON failure on stdout
const fs = require('fs');
const argv = process.argv.slice(2);
if (process.env.FEED_STUB_LOG) fs.appendFileSync(process.env.FEED_STUB_LOG, JSON.stringify(argv) + '\n');
if (argv[0] !== 'feed' || argv[1] !== 'answer') { process.stderr.write(`error: unknown command '${argv[0]}'\n`); process.exit(1); }
const key = argv[2];
const mode = process.env.FEED_STUB_MODE || '';
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
if (mode === 'failed') { out({ status: 'failed', delivery: 'failed', resolved: false, reason: 'the terminal is gone', attentionKey: key }); process.exit(0); }
if (mode === 'error') { out({ status: 'failed', delivery: 'failed', resolved: false, reason: 'unknown attention key', code: 'not_found', attentionKey: key }); process.exit(1); }
out({ status: 'delivered', delivery: 'terminal', resolved: true, receipt: { msgId: 'm1', status: 'consumed', at: '2026-10-14T00:00:00Z' }, attentionKey: key });
