    "configuration": {
      "title": "Agents: Autogit",
      "properties": {
        "agents.commitMessageExamples": {
          "type": "array",
          "default": [
            "feat: add user authentication with jwt tokens",
            "fix: resolve null pointer exception in payment handler",
            "docs: update api reference for v2 endpoints",
            "build: configure webpack for production optimization",
            "refactor: extract validation logic into separate module",
            "fix: correct timezone handling in date formatter",
            "feat: implement real-time notifications via websockets",
            "release: bump version to 1.2.0 for stable release",
            "refactor: simplify error handling in api client",
            "docs: add examples for configuration options"
          ],
          "items": {
            "type": "string"
          },
          "description": "Example commit messages to guide the AI style"
        },
        "agents.ignoreFiles": {
          "type": "string",
          "default": "node_modules,dist,build,out,.git,*.lock,bun.lock,package-lock.json",
          "description": "Comma-separated patterns of files to ignore in diffs"
        },
        "agents.editor.assetFolder": {
          "type": "string",
          "default": ".assets",
          "description": "Folder for storing images and attachments from the markdown editor"
        },
        "agents.disableAutopush": {
          "type": "boolean",
          "default": false,
          "description": "Disable auto-push after commit. When enabled, Autogit will stage changes, generate commit message, and commit, but skip pushing to remote."
        },
        "agents.disableAutocommit": {
          "type": "boolean",
          "default": false,
          "description": "Disable auto-commit. When enabled, Autogit will only stage changes and generate a commit message, but not commit or push."
        },
        "agents.commitGenTimeoutMs": {
          "type": "number",
          "default": 60000,
          "description": "Timeout (ms) for the `agents run claude --model haiku` call that generates commit messages. Increase if commits are slow to generate."
        },
        "agents.launch.defaultTarget": {
          "type": "string",
          "enum": [
            "auto",
            "local",
            "ask"
          ],
          "enumDescriptions": [
            "Let the CLI pick a device (`--device auto`). Once you mark devices with `agents devices role <name> worker`, new agents rotate over those workers only.",
            "Always run on this machine.",
            "Prompt for the host on every launch."
          ],
          "default": "auto",
          "description": "Where the per-harness \"Agents: New <Harness>\" commands run. Device choice stays with the CLI: 'auto' emits --device auto, which draws from the fleet's worker pool (agents devices role). The (Pick Host), (Auto), (Pick Project), (Pick Account), and (Local) command variants are unaffected."
        },
        "agents.links.openIn": {
          "type": "string",
          "enum": [
            "editor",
            "browser"
          ],
          "enumDescriptions": [
            "Open PRs, tickets and other web links, including links in agent tabs, as editor tabs in the integrated browser, so you act on them beside your agents. A second click on the same page brings its tab forward. Editors without the integrated browser open your default browser.",
            "Open web links in your default browser."
          ],
          "default": "editor",
          "markdownDescription": "Where the extension opens GitHub PRs, Linear tickets and other web links, including a link printed in a tab the extension opened (agent tabs then print links as plain text). In the panels, a ⌘, Ctrl or ⌥ click always opens your default browser; in such a tab, the terminal's own link click (⌘-click, or ⌥-click when `#editor.multiCursorModifier#` is `ctrlCmd`) opens it here. Sign in to GitHub and Linear once in the integrated browser; it keeps the sign-in across workspaces (`#workbench.browser.dataStorage#`)."
        },
        "agents.links.tabs": {
          "type": "string",
          "enum": [
            "reuse",
            "single",
            "new"
          ],
          "enumDescriptions": [
            "A page that is already open comes forward; any other link opens a new tab.",
            "Every link shows in one browser tab, replacing the page it showed. Your own browser tabs count too.",
            "Every click opens a new browser tab."
          ],
          "default": "reuse",
          "markdownDescription": "Which integrated browser tab a PR, ticket or other web link opens in, when `#agents.links.openIn#` is `editor`. Default zoom and the browser's other settings are the editor's own: `#workbench.browser.pageZoom#`, `#workbench.browser.newTabPlacement#`."
        },
        "agents.dictation.model": {
          "type": "string",
          "default": "~/.cache/whisper-models/ggml-large-v3-turbo.bin",
          "markdownDescription": "The whisper.cpp model the reply box's mic transcribes with, on this machine. Needs `ffmpeg` and `whisper-cli` (`brew install ffmpeg whisper-cpp`)."
        },
        "agents.lead.speak": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "The Lead reads its answers aloud on this machine as they stream (`agents lead ask --speak`; agents-cli does the speaking). The speaker in the Lead tab's header turns it on and off."
        }
      }
    },
    "configurationDefaults": {
      "terminal.integrated.confirmOnKill": "panel",
      "terminal.integrated.enablePersistentSessions": false,
      "terminal.integrated.commandsToSkipShell": [
        "agents.lead.talk"
      ]
    },
    "customEditors": [
