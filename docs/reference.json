    "menus": {
      "editor/title": [
        {
          "command": "agents.open",
          "group": "navigation",
          "when": "true"
        }
      ],
      "scm/title": [
        {
          "command": "agents.autogit",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "terminal/context": [
        {
          "command": "agents.askAnotherAgent",
          "group": "agents@1"
        },
        {
          "command": "agents.detach",
          "group": "agents@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agents.project.tab",
          "when": "false"
        },
        {
          "command": "agents.setSessionId",
          "when": "agents.activeIsAgent"
        },
        {
          "command": "agents.newAntigravity",
          "when": "true",
          "group": "navigation@2"
        },
        {
          "command": "agents.newGrok",
          "when": "true",
          "group": "navigation@2"
        },
        {
          "command": "agents.newKimi",
          "when": "true",
          "group": "navigation@2"
        },
        {
          "command": "agents.newDroid",
          "when": "true",
          "group": "navigation@2"
        },
        {
          "command": "agents.enableReader",
          "when": "!agents.readerEnabled",
          "group": "navigation@6"
        },
        {
          "command": "agents.disableReader",
          "when": "agents.readerEnabled",
          "group": "navigation@6"
        },
        {
          "command": "agents.lead.dock",
          "when": "agents.lead.bubble"
        },
        {
          "command": "agents.lead.float",
          "when": "!agents.lead.bubble"
        }
      ],
      "view/title": [
        {
          "command": "agents.project.pick",
          "when": "view == agentsProject.panel",
          "group": "navigation@1"
        },
        {
          "command": "agents.project.settings",
          "when": "view == agentsProject.panel",
          "group": "navigation@2"
        },
        {
          "command": "agents.project.popOut",
          "when": "view == agentsProject.panel",
          "group": "navigation@3"
        },
        {
          "command": "agents.activeSession.popOut",
          "when": "view == agentsPanel.terminal",
          "group": "navigation@1"
        }
      ]
    },
    "views": {
      "agentsPanel": [
        {
          "type": "webview",
          "id": "agentsPanel.terminal",
          "name": "Active Terminal"
        }
      ],
      "agentsProject": [
        {
          "type": "webview",
          "id": "agentsProject.panel",
          "name": "Project"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentsPanel",
          "title": "Agents",
          "icon": "assets/agents-activity.svg"
        },
        {
          "id": "agentsProject",
          "title": "Project",
          "icon": "assets/project-activity.svg"
        }
      ]
    }
