        "mac": "cmd+shift+alt+d",
        "when": "terminalFocus"
      },
      {
        "command": "agents.attach",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a"
      },
      {
        "command": "agents.searchSessions",
        "mac": "cmd+k",
        "when": "focusedView == agentsProject.panel || focusedView == agentsPanel.terminal || terminalFocus && agents.activeIsAgent"
      },
      {
        "command": "agents.searchSessions",
        "key": "ctrl+k",
        "when": "!isMac && (focusedView == agentsProject.panel || focusedView == agentsPanel.terminal)"
      },
      {
        "command": "agents.newAgent",
